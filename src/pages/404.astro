---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Page not found — Cadence"
  description="The requested Cadence page could not be found."
  canonicalPath="/404"
>
  <main class="not-found">
    <div class="not-found__content">
      <p class="not-found__eyebrow">404</p>
      <h1>That page isn’t part of the cadence.</h1>
      <p>It may have moved, or the address may be incorrect. Start from the resource library or return home.</p>
      <div class="not-found__actions">
        <a class="btn btn-primary" href={withBase('/')}>Return home</a>
        <a class="btn btn-secondary" href={withBase('/resources')}>Browse resources</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found { min-height: 58vh; display: grid; place-items: center; padding: 80px 24px; background: var(--gray-50); }
  .not-found__content { max-width: 640px; text-align: center; }
  .not-found__eyebrow { color: var(--secondary); font-size: 14px; font-weight: 800; letter-spacing: .12em; margin: 0 0 12px; }
  .not-found h1 { color: var(--primary); font-size: clamp(36px, 6vw, 60px); letter-spacing: -.04em; line-height: 1.05; margin: 0 0 18px; }
  .not-found p { color: var(--gray-600); font-size: 18px; line-height: 1.6; margin: 0; }
  .not-found__actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
</style>
